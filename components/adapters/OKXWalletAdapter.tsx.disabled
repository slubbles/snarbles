'use client';

import React, { useState, useEffect, useCallback } from 'react';
import { WalletAdapter, WalletReadyState, WalletName } from '@solana/wallet-adapter-base';
import { PublicKey } from '@solana/web3.js';

// OKX Wallet Adapter
class OKXWalletAdapter implements WalletAdapter {
  name: WalletName<'OKX Wallet'> = 'OKX Wallet' as WalletName<'OKX Wallet'>;
  url = 'https://www.okx.com/web3';
  icon = 'data:image/svg+xml;base64,';
  readonly supportedTransactionVersions = null;

  private _connecting: boolean;
  private _connected: boolean;
  private _publicKey: PublicKey | null;
  private _readyState: WalletReadyState;

  constructor() {
    this._connecting = false;
    this._connected = false;
    this._publicKey = null;
    this._readyState = typeof window !== 'undefined' && 'okxwallet' in window 
      ? WalletReadyState.Installed 
      : WalletReadyState.NotDetected;
  }

  get connecting() {
    return this._connecting;
  }

  get connected() {
    return this._connected;
  }

  get publicKey() {
    return this._publicKey;
  }

  get readyState() {
    return this._readyState;
  }

  async connect(): Promise<void> {
    try {
      this._connecting = true;
      
      if (typeof window === 'undefined' || !('okxwallet' in window)) {
        throw new Error('OKX Wallet not detected. Please install the OKX Wallet extension.');
      }

      const okxWallet = (window as any).okxwallet?.solana;
      if (!okxWallet) {
        throw new Error('OKX Wallet Solana provider not found.');
      }

      const response = await okxWallet.connect();
      if (response?.publicKey) {
        this._publicKey = new PublicKey(response.publicKey);
        this._connected = true;
        this.emit('connect', this._publicKey);
      } else {
        throw new Error('Failed to connect to OKX Wallet');
      }
    } catch (error) {
      this.emit('error', error);
      throw error;
    } finally {
      this._connecting = false;
    }
  }

  async disconnect(): Promise<void> {
    try {
      if (typeof window !== 'undefined' && 'okxwallet' in window) {
        const okxWallet = (window as any).okxwallet?.solana;
        if (okxWallet?.disconnect) {
          await okxWallet.disconnect();
        }
      }
    } catch (error) {
      console.warn('Error disconnecting from OKX Wallet:', error);
    } finally {
      this._connected = false;
      this._publicKey = null;
      this.emit('disconnect');
    }
  }

  async sendTransaction(): Promise<never> {
    throw new Error('sendTransaction not implemented for OKX Wallet adapter');
  }

  async signTransaction(): Promise<never> {
    throw new Error('signTransaction not implemented for OKX Wallet adapter');
  }

  async signAllTransactions(): Promise<never> {
    throw new Error('signAllTransactions not implemented for OKX Wallet adapter');
  }

  async signMessage(): Promise<never> {
    throw new Error('signMessage not implemented for OKX Wallet adapter');
  }

  // Event emitter functionality
  private _listeners: Record<string, Function[]> = {};

  emit(event: string, ...args: any[]) {
    const listeners = this._listeners[event] || [];
    listeners.forEach(listener => {
      try {
        listener(...args);
      } catch (error) {
        console.error('Error in wallet event listener:', error);
      }
    });
  }

  on(event: string, listener: Function) {
    if (!this._listeners[event]) {
      this._listeners[event] = [];
    }
    this._listeners[event].push(listener);
  }

  off(event: string, listener: Function) {
    if (!this._listeners[event]) return;
    const index = this._listeners[event].indexOf(listener);
    if (index > -1) {
      this._listeners[event].splice(index, 1);
    }
  }
}

export default OKXWalletAdapter;
