# Snarbles Token Platform Environment Variables
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# REQUIRED VARIABLES (Core functionality)
# =============================================================================

# Solana Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# Algorand USDT Credit Purchase Configuration
# These addresses receive USDt payments for credit purchases
ALGORAND_MAINNET_RECEIVER_ADDRESS=your-mainnet-algorand-address-here
ALGORAND_TESTNET_RECEIVER_ADDRESS=your-testnet-algorand-address-here

# =============================================================================
# OPTIONAL VARIABLES (Enhanced features)
# =============================================================================

# Supabase Database (for fee tracking, analytics, user authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Filebase S3 Storage (for metadata and file storage)
NEXT_PUBLIC_FILEBASE_ACCESS_KEY=your-filebase-access-key
NEXT_PUBLIC_FILEBASE_SECRET_KEY=your-filebase-secret-key
NEXT_PUBLIC_FILEBASE_ENDPOINT=https://s3.filebase.com
NEXT_PUBLIC_FILEBASE_BUCKET=snarbles-token-creator-dapp

# Analytics Services
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# Error Tracking
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# =============================================================================
# NETWORK CONFIGURATIONS
# =============================================================================

# Solana Networks
# For Mainnet:
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# NEXT_PUBLIC_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# For custom RPC:
# NEXT_PUBLIC_RPC_ENDPOINT=https://your-custom-rpc-endpoint.com

# =============================================================================
# SECURITY & PERFORMANCE
# =============================================================================

# Rate Limiting (optional, handled client-side)
NEXT_PUBLIC_RATE_LIMIT_ENABLED=true

# Feature Flags
NEXT_PUBLIC_ENABLE_SOLANA=true
NEXT_PUBLIC_ENABLE_ALGORAND=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true

# =============================================================================
# DEPLOYMENT VARIABLES
# =============================================================================

# Netlify/Vercel deployment settings
NEXT_TELEMETRY_DISABLED=1
NODE_VERSION=18

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env.local:
#    cp env.example .env.local

# 2. Fill in the required variables (SOLANA_NETWORK and RPC_ENDPOINT)

# 3. Optional: Set up Supabase for enhanced features:
#    - Go to https://supabase.com
#    - Create a new project
#    - Copy the URL and anon key
#    - Run the database migrations in /supabase/migrations/

# 4. Optional: Set up other services for full functionality:
#    - Filebase for decentralized storage
#    - Google Analytics for tracking
#    - Sentry for error monitoring

# 5. Test your setup:
#    npm run dev

# =============================================================================
# NOTES
# =============================================================================

# - The app works with just the Solana variables set
# - Supabase enables fee tracking and user management
# - Analytics and error tracking improve monitoring
# - All variables starting with NEXT_PUBLIC_ are exposed to the browser
# - Keep secret keys secure and never commit them to version control

# =============================================================================
# DEVELOPMENT vs PRODUCTION
# =============================================================================

# Development (recommended):
# - Use devnet for Solana
# - Use test/staging services for external APIs

# Production:
# - Use mainnet-beta for Solana
# - Use production services
# - Enable all monitoring and analytics
# - Consider using custom RPC endpoints for better performance 